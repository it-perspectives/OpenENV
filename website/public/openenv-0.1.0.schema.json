{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/it-perspectives/OpenENV/v0.1.0/schemas/openenv-0.1.0.schema.json",
  "title": "OpenENV 0.1.0 environment variable contract",
  "type": "object",
  "required": [
    "openenv",
    "info",
    "variables"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": {}
  },
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/it-perspectives/OpenENV/v0.1.0/schemas/openenv-0.1.0.schema.json"
    },
    "openenv": {
      "const": "0.1.0"
    },
    "info": {
      "type": "object",
      "required": [
        "title",
        "version"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": {}
      },
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/variable"
      }
    }
  },
  "$defs": {
    "value": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "variable": {
      "type": "object",
      "required": [
        "description",
        "type"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9][A-Za-z0-9._-]*$": {}
      },
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "array"
          ]
        },
        "delimiter": {
          "description": "Required for array variables: a single space or comma.",
          "enum": [" ", ","]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "sensitive": {
          "type": "boolean",
          "default": false
        },
        "deprecated": {
          "type": "boolean",
          "default": false
        },
        "default": {
          "$ref": "#/$defs/value"
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "format": {
          "enum": [
            "uri",
            "uri-reference",
            "email",
            "hostname",
            "ipv4",
            "ipv6"
          ]
        },
        "pattern": {
          "type": "string"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "array" } }
          },
          "then": {
            "properties": { "delimiter": {} },
            "required": ["delimiter"]
          },
          "else": {
            "properties": { "delimiter": false }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "else": {
            "properties": {
              "format": false,
              "pattern": false,
              "minLength": false,
              "maxLength": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "integer",
                  "number"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "minimum": false,
              "maximum": false
            }
          }
        },
        {
          "if": {
            "required": [
              "sensitive"
            ],
            "properties": {
              "sensitive": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "default": false,
              "examples": false,
              "enum": false
            }
          }
        }
      ]
    }
  }
}
