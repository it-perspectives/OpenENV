---
interface Props {
  items: { label: string; title: string; description: string }[];
}
const { items } = Astro.props;
---

<div class="flow">
  {items.map((item) => (
    <div class="flow-item">
      <span class="number">{item.label}</span>
      <h3>{item.title}</h3>
      <p>{item.description}</p>
    </div>
  ))}
</div>
